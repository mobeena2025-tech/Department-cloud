# Copy to .env and fill in. Never commit .env.
# Supabase project URL (Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only SECRET key (Settings -> API Keys -> Secret keys, starts with sb_secret_).
# Never put this in src/ or share it. Renamed to SUPABASE_SECRET_KEY in Phase 3.
SUPABASE_KEY=
# API port (Vite proxies /api to 5000; change vite.config.js too if you change this)
API_PORT=5000
