# Copy to .env and fill in. Never commit .env.
# Supabase project URL (Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only key. Phase 1-2 use the current key; Phase 3 switches to SUPABASE_SECRET_KEY.
SUPABASE_KEY=
# API port (Vite proxies /api here)
PORT=5000
